#!/bin/bash
# fana-deploy CLI orchestrator for Laravel on Alpine aarch64
set -euo pipefail

BASE_DIR="/home/fana-deploy"
CONFIG_FILE="${BASE_DIR}/deployment/config.yml"
SCRIPTS_DIR="${BASE_DIR}/scripts"
TEMPLATES_DIR="${BASE_DIR}/templates"
APPS_DIR="${BASE_DIR}/deployment/apps"
CADDY_SITES_DIR="${BASE_DIR}/deployment/caddy/sites"
LOGS_DIR="${BASE_DIR}/deployment/logs"
BACKUPS_DIR="${BASE_DIR}/deployment/backups"

source "${SCRIPTS_DIR}/logging.sh"

get_config_val() {
    local key="$1"
    local default_val="$2"
    if [ -f "${CONFIG_FILE}" ]; then
        local val
        val=$(awk -F': ' -v k="${key}" '$1 == k {gsub(/^[ \t]+|[ \t]+$/, "", $2); print $2}' "${CONFIG_FILE}" | head -n1)
        if [ -n "${val}" ]; then
            echo "${val}"
            return
        fi
    fi
    echo "${default_val}"
}

DEFAULT_DOMAIN=$(get_config_val "domain" "fmo.qzz.io")
ORIGIN_PORT=$(get_config_val "origin_port" "8088")

prune_retention() {
    local app="$1"
    local releases_dir="${APPS_DIR}/${app}/releases"
    local backups_dir="${BACKUPS_DIR}/${app}"

    if [ -d "${releases_dir}" ]; then
        local count
        count=$(ls -1d "${releases_dir}"/* 2>/dev/null | wc -l)
        if [ "${count}" -gt 3 ]; then
            ls -1td "${releases_dir}"/* 2>/dev/null | tail -n +"$((3 + 1))" | xargs -r rm -rf
            log_info "Pruned older releases for ${app} (retained 3)."
        fi
    fi

    if [ -d "${backups_dir}" ]; then
        local bcount
        bcount=$(ls -1 "${backups_dir}"/*.sqlite 2>/dev/null | wc -l)
        if [ "${bcount}" -gt 5 ]; then
            ls -1t "${backups_dir}"/*.sqlite 2>/dev/null | tail -n +"$((5 + 1))" | xargs -r rm -f
            log_info "Pruned older backups for ${app} (retained 5)."
        fi
    fi
}

cmd_deploy() {
    local url="${1:-}"
    if [ -z "${url}" ]; then
        log_error "Usage: fana-deploy deploy <git_url> [as <app_name>] [domain <hostname>]"
        exit 1
    fi
    shift

    local app_name=""
    local custom_domain=""

    while [ $# -gt 0 ]; do
        case "$1" in
            as)
                app_name="$2"
                shift 2
                ;;
            domain)
                custom_domain="$2"
                shift 2
                ;;
            *)
                shift
                ;;
        esac
    done

    if [ -z "${app_name}" ]; then
        app_name=$(basename "${url}" .git | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9_-]//g')
    fi

    local domain="${custom_domain:-${app_name}.${DEFAULT_DOMAIN}}"

    log_info "Starting deployment for app: ${app_name} (domain: ${domain})..."

    # 1. Preflight
    "${SCRIPTS_DIR}/preflight.sh" "${app_name}"

    # 2. Acquire app lock
    "${SCRIPTS_DIR}/lock.sh" app "${app_name}" bash -c "
        set -euo pipefail
        APP_ROOT=\"${APPS_DIR}/${app_name}\"
        RELEASES_DIR=\"\${APP_ROOT}/releases\"
        SHARED_DIR=\"\${APP_ROOT}/shared\"
        BACKUP_APP_DIR=\"${BACKUPS_DIR}/${app_name}\"
        RELEASE_ID=\"\$(date +%Y%m%d%H%M%S)\"
        TARGET_DIR=\"\${RELEASES_DIR}/\${RELEASE_ID}\"

        mkdir -p \"\${RELEASES_DIR}\" \"\${SHARED_DIR}/database\" \"\${SHARED_DIR}/storage/app\"
        mkdir -p \"\${SHARED_DIR}/storage/framework/cache/data\" \"\${SHARED_DIR}/storage/framework/sessions\"
        mkdir -p \"\${SHARED_DIR}/storage/framework/views\" \"\${SHARED_DIR}/storage/logs\"
        mkdir -p \"\${BACKUP_APP_DIR}\"

        echo '[DEPLOY] Cloning repository...'
        git clone --depth 1 \"${url}\" \"\${TARGET_DIR}\"

        echo '[DEPLOY] Running preflight check on repo stack...'
        \"${SCRIPTS_DIR}/preflight.sh\" \"${app_name}\" \"\${TARGET_DIR}\"

        # Check composer.lock
        if [ ! -f \"\${TARGET_DIR}/composer.lock\" ]; then
            echo '[ERROR] composer.lock is required. Aborting.' >&2
            rm -rf \"\${TARGET_DIR}\"
            exit 1
        fi

        # Setup SQLite DB in shared
        DB_PATH=\"\${SHARED_DIR}/database/database.sqlite\"
        if [ ! -f \"\${DB_PATH}\" ]; then
            touch \"\${DB_PATH}\"
            sqlite3 \"\${DB_PATH}\" 'PRAGMA journal_mode=WAL; PRAGMA synchronous=NORMAL;'
            chmod 664 \"\${DB_PATH}\"
        fi

        # Setup .env
        ENV_PATH=\"\${SHARED_DIR}/.env\"
        if [ ! -f \"\${ENV_PATH}\" ]; then
            if [ -f \"\${TARGET_DIR}/.env.example\" ]; then
                cp \"\${TARGET_DIR}/.env.example\" \"\${ENV_PATH}\"
            else
                touch \"\${ENV_PATH}\"
            fi
            sed -i '/^DB_/d' \"\${ENV_PATH}\" 2>/dev/null || true
            cat << 'ENVEOF' >> \"\${ENV_PATH}\"
DB_CONNECTION=sqlite
DB_DATABASE=\${DB_PATH}
DB_FOREIGN_KEYS=true
APP_ENV=production
APP_DEBUG=false
LOG_CHANNEL=daily
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
ENVEOF
            sed -i \"s|\\\${DB_PATH}|\${DB_PATH}|g\" \"\${ENV_PATH}\"
        fi

        # Symlinks into release
        rm -f \"\${TARGET_DIR}/.env\" && ln -sfn \"\${ENV_PATH}\" \"\${TARGET_DIR}/.env\"
        rm -rf \"\${TARGET_DIR}/storage\" && ln -sfn \"\${SHARED_DIR}/storage\" \"\${TARGET_DIR}/storage\"
        mkdir -p \"\${TARGET_DIR}/database\"
        ln -sfn \"\${DB_PATH}\" \"\${TARGET_DIR}/database/database.sqlite\"

        # Generate app key if needed
        if ! grep -q '^APP_KEY=base64:' \"\${ENV_PATH}\" || grep -q '^APP_KEY=$' \"\${ENV_PATH}\"; then
            echo '[DEPLOY] APP_KEY missing or empty. Generating key...'
            APP_KEY_GEN=\$(php -r 'echo \"base64:\".base64_encode(random_bytes(32));')
            sed -i '/^APP_KEY=/d' \"\${ENV_PATH}\" 2>/dev/null || true
            echo \"APP_KEY=\${APP_KEY_GEN}\" >> \"\${ENV_PATH}\"
        fi

        # Heavy Composer install
        echo '[DEPLOY] Installing composer dependencies with --no-dev under heavy lock...'
        run_composer() {
            \"${SCRIPTS_DIR}/lock.sh\" heavy env COMPOSER_MEMORY_LIMIT=1G composer install --no-dev --prefer-dist --classmap-authoritative --no-interaction --working-dir=\"\${TARGET_DIR}\"
        }

        if ! run_composer; then
            ec=\$?
            echo \"[WARN] Composer install failed with code \${ec}. Checking dmesg...\"
            dmesg | tail -n 10
            echo \"[DEPLOY] Retrying composer install once...\"
            run_composer
        fi

        # Frontend build
        if [ -d \"\${TARGET_DIR}/public/build\" ]; then
            echo '[DEPLOY] public/build exists. Skipping npm build.'
        elif [ -f \"\${TARGET_DIR}/package.json\" ]; then
            echo '[DEPLOY] Building frontend assets under heavy lock...'
            \"${SCRIPTS_DIR}/lock.sh\" heavy bash -c \"cd '\${TARGET_DIR}' && NODE_OPTIONS=--max-old-space-size=768 npm ci && npm run build\"
            rm -rf \"\${TARGET_DIR}/node_modules\"
        fi

        # Database migration with backup
        if [ -s \"\${DB_PATH}\" ]; then
            cp \"\${DB_PATH}\" \"\${BACKUP_APP_DIR}/db_predeploy_\${RELEASE_ID}.sqlite\"
        fi
        echo '[DEPLOY] Running migrations under heavy lock...'
        \"${SCRIPTS_DIR}/lock.sh\" heavy php \"\${TARGET_DIR}/artisan\" migrate --force || true

        # Seeder check & execution (First deploy or unseeded)
        META_FILE=\"\${APP_ROOT}/meta.json\"
        FIRST_DEPLOY=false
        if [ ! -f \"\${META_FILE}\" ]; then
            FIRST_DEPLOY=true
            echo '{\"first_deployed_at\":\"'\"\$(date -u +%Y-%m-%dT%H:%M:%SZ)\"'\",\"seeded\":false}' > \"\${META_FILE}\"
        fi

        IS_SEEDED=\$(grep -q '\"seeded\":true' \"\${META_FILE}\" 2>/dev/null && echo \"true\" || echo \"false\")
        if [ \"\${FIRST_DEPLOY}\" = \"true\" ] || [ \"\${IS_SEEDED}\" = \"false\" ]; then
            if [ -f \"\${TARGET_DIR}/database/seeders/DatabaseSeeder.php\" ] || [ -f \"\${TARGET_DIR}/database/seeds/DatabaseSeeder.php\" ]; then
                echo '[DEPLOY] Database seeder detected on first deploy. Running seeder under heavy lock...'
                \"${SCRIPTS_DIR}/lock.sh\" heavy php \"\${TARGET_DIR}/artisan\" db:seed --force || true
                sed -i 's/\"seeded\":false/\"seeded\":true/g' \"\${META_FILE}\" 2>/dev/null || true
            fi
        fi

        # Atomically activate release
        ln -sfn \"\${TARGET_DIR}\" \"\${APP_ROOT}/current\"

        # Build config/events/route/view caches for the release that is now live.
        # Built last and never cleared again: the app serves from these until the
        # next deploy, and optimize:clear deadlocks a live worker when
        # CACHE_STORE/SESSION_DRIVER is the database.
        echo '[DEPLOY] Building Laravel caches...'
        php \"\${TARGET_DIR}/artisan\" optimize >/dev/null 2>&1 || true

        chown -R fana:fana \"\${APP_ROOT}\"
        chmod -R 775 \"\${SHARED_DIR}/storage\" \"\${SHARED_DIR}/database\"
        chmod 664 \"\${DB_PATH}\"
    "

    # 3. Configure Caddy site
    mkdir -p "${CADDY_SITES_DIR}"
    local site_caddy="${CADDY_SITES_DIR}/${app_name}.caddy"
    cat << EOF > "${site_caddy}"
http://${domain} {
    bind 127.0.0.1
    root * ${APPS_DIR}/${app_name}/current/public
    encode zstd gzip
    file_server
    php_server
    log {
        output file ${LOGS_DIR}/${app_name}.log {
            roll_size 10MiB
            roll_keep 3
        }
    }
}
EOF
    chown fana:fana "${site_caddy}"

    # Validate and reload Caddy
    su -s /bin/bash fana -c "frankenphp validate --adapter caddyfile --config ${BASE_DIR}/deployment/caddy/Caddyfile"
    cmd_restart "${app_name}"

    # 4. Ingress configuration
    "${SCRIPTS_DIR}/ingress_tool.py" add "${domain}"
    if command -v cloudflared >/dev/null 2>&1; then
        cloudflared tunnel route dns 65836ee6-469f-4372-83bb-6d8844dfd338 "${domain}" 2>/dev/null || true
    fi

    # 5. Cron Queue & Scheduler setup
    local cron_line="* * * * * su -s /bin/sh fana -c 'php ${APPS_DIR}/${app_name}/current/artisan schedule:run > /dev/null 2>&1'"
    if ! crontab -l 2>/dev/null | grep -F "${APPS_DIR}/${app_name}/current/artisan schedule:run" >/dev/null 2>&1; then
        (crontab -l 2>/dev/null ; echo "${cron_line}") | crontab -
    fi

    # 6. Retention prune
    prune_retention "${app_name}"

    # 7. Update Monitoring Registry
    "${SCRIPTS_DIR}/update_registry.py" 2>/dev/null || true

    log_success "Deployment complete for ${app_name}! Domain: http://${domain} (Origin 127.0.0.1:8088)"
}

cmd_update() {
    local app_name="${1:-}"
    if [ -z "${app_name}" ] || [ ! -d "${APPS_DIR}/${app_name}" ]; then
        log_error "App not found: ${app_name}"
        exit 1
    fi
    local remote_url
    remote_url=$(git -C "${APPS_DIR}/${app_name}/current" config --get remote.origin.url || true)
    if [ -z "${remote_url}" ]; then
        log_error "Could not determine git origin url for ${app_name}."
        exit 1
    fi
    local domain
    domain=$(awk '/^http:\/\//{gsub(/http:\/\/|:8088|\{|\s+/, "", $1); print $1; exit}' "${CADDY_SITES_DIR}/${app_name}.caddy" || echo "")
    cmd_deploy "${remote_url}" as "${app_name}" domain "${domain}"
}

cmd_rollback() {
    local app_name="${1:-}"
    "${SCRIPTS_DIR}/rollback.sh" "${app_name}"
    "${SCRIPTS_DIR}/update_registry.py" 2>/dev/null || true
}

cmd_status() {
    local app_name="${1:-}"
    if [ -n "${app_name}" ]; then
        if [ ! -d "${APPS_DIR}/${app_name}" ]; then
            log_error "App not found: ${app_name}"
            exit 1
        fi
        echo "=== Application Status: ${app_name} ==="
        local current_target
        current_target=$(readlink -f "${APPS_DIR}/${app_name}/current" || echo "unknown")
        echo "Current Release: $(basename "${current_target}")"
        echo "Git Commit:      $(git -C "${current_target}" rev-parse --short HEAD 2>/dev/null || echo 'N/A')"
        echo "Database Size:   $(ls -lh "${APPS_DIR}/${app_name}/shared/database/database.sqlite" 2>/dev/null | awk '{print $5}' || echo 'N/A')"
        local site_caddy="${CADDY_SITES_DIR}/${app_name}.caddy"
        if [ -f "${site_caddy}" ]; then
            local domain
            domain=$(awk '/^http:\/\//{gsub(/http:\/\/|:8088|\{|\s+/, "", $1); print $1; exit}' "${site_caddy}" || echo "")
            echo "Domain:          ${domain}"
            echo -n "HTTP Origin Check: "
            curl -s -o /dev/null -w "%{http_code}\n" -H "Host: ${domain}" http://127.0.0.1:8088/ || echo "Error"
            echo -n "Public HTTPS Check: "
            curl -s -o /dev/null -w "%{http_code}\n" --connect-timeout 3 "https://${domain}/" || echo "Error"
        fi
        echo ""
        echo "Recent Logs:"
        tail -n 5 "${LOGS_DIR}/${app_name}.log" 2>/dev/null || echo "No logs yet."
    else
        "${SCRIPTS_DIR}/health_check.sh"
        echo ""
        echo "=== Active Applications ==="
        cmd_list
    fi
}

cmd_logs() {
    local app_name="${1:-}"
    if [ -z "${app_name}" ]; then
        log_error "Usage: fana-deploy logs <app_name>"
        exit 1
    fi
    if [ -f "${LOGS_DIR}/${app_name}.log" ]; then
        tail -n 50 "${LOGS_DIR}/${app_name}.log"
    elif [ -f "${APPS_DIR}/${app_name}/shared/storage/logs/laravel.log" ]; then
        tail -n 50 "${APPS_DIR}/${app_name}/shared/storage/logs/laravel.log"
    else
        log_warn "No log file found for ${app_name}."
    fi
}

cmd_restart() {
    local app_name="${1:-}"
    log_info "Restarting FrankenPHP and clearing opcache..."
    pkill -TERM -f "frankenphp run" 2>/dev/null || true
    sleep 0.5
    su -s /bin/sh fana -c "GOMEMLIMIT=350MiB GOGC=75 nohup /usr/local/bin/frankenphp run --config ${BASE_DIR}/deployment/caddy/Caddyfile --adapter caddyfile >> ${BASE_DIR}/deployment/logs/frankenphp.stdout.log 2>&1 &"
    sleep 0.5
    if command -v php >/dev/null 2>&1; then
        php -r "if (function_exists('opcache_reset')) opcache_reset();" 2>/dev/null || true
    fi
    log_success "FrankenPHP restarted."
}

cmd_backup() {
    local app_name="${1:-}"
    if [ -z "${app_name}" ] || [ ! -d "${APPS_DIR}/${app_name}" ]; then
        log_error "App not found: ${app_name}"
        exit 1
    fi
    local backup_dir="${BACKUPS_DIR}/${app_name}"
    mkdir -p "${backup_dir}"
    local dest="${backup_dir}/manual_$(date +%Y%m%d%H%M%S).sqlite"
    cp "${APPS_DIR}/${app_name}/shared/database/database.sqlite" "${dest}"
    prune_retention "${app_name}"
    log_success "Manual backup created at ${dest}"
}

cmd_restore() {
    local app_name="${1:-}"
    local backup_file="${2:-}"
    if [ -z "${app_name}" ] || [ -z "${backup_file}" ]; then
        log_error "Usage: fana-deploy restore <app_name> <backup_file>"
        exit 1
    fi
    if [ ! -f "${backup_file}" ]; then
        log_error "Backup file not found: ${backup_file}"
        exit 1
    fi
    cp "${backup_file}" "${APPS_DIR}/${app_name}/shared/database/database.sqlite"
    chown fana:fana "${APPS_DIR}/${app_name}/shared/database/database.sqlite"
    chmod 664 "${APPS_DIR}/${app_name}/shared/database/database.sqlite"
    log_success "Restored database from ${backup_file}"
}

cmd_remove() {
    local app_name="${1:-}"
    if [ -z "${app_name}" ] || [ ! -d "${APPS_DIR}/${app_name}" ]; then
        log_error "App not found: ${app_name}"
        exit 1
    fi
    log_warn "Removing app ${app_name}..."

    # 1. Archive final DB
    mkdir -p "${BACKUPS_DIR}/${app_name}"
    if [ -f "${APPS_DIR}/${app_name}/shared/database/database.sqlite" ]; then
        cp "${APPS_DIR}/${app_name}/shared/database/database.sqlite" "${BACKUPS_DIR}/${app_name}/final_archive.sqlite"
    fi

    # 2. Remove ingress
    local site_caddy="${CADDY_SITES_DIR}/${app_name}.caddy"
    if [ -f "${site_caddy}" ]; then
        local domain
        domain=$(awk '/^http:\/\//{gsub(/http:\/\/|:8088|\{|\s+/, "", $1); print $1; exit}' "${site_caddy}" || echo "")
        if [ -n "${domain}" ]; then
            "${SCRIPTS_DIR}/ingress_tool.py" remove "${domain}"
        fi
        rm -f "${site_caddy}"
        cmd_restart "${app_name}"
    fi

    # 3. Remove cron
    crontab -l 2>/dev/null | grep -v "${APPS_DIR}/${app_name}" | crontab - || true

    # 4. Remove files
    rm -rf "${APPS_DIR}/${app_name}"

    # 5. Update Monitoring Registry
    "${SCRIPTS_DIR}/update_registry.py" 2>/dev/null || true

    log_success "App ${app_name} removed. (Final database archive saved in ${BACKUPS_DIR}/${app_name}/final_archive.sqlite)"
}

cmd_list() {
    if [ ! -d "${APPS_DIR}" ] || [ -z "$(ls -A "${APPS_DIR}" 2>/dev/null)" ]; then
        echo "No apps deployed."
        return
    fi
    printf "%-16s %-24s %-20s %-10s\n" "APP" "DOMAIN" "CURRENT RELEASE" "STATUS"
    printf "%-16s %-24s %-20s %-10s\n" "---" "------" "---------------" "------"
    for d in "${APPS_DIR}"/*; do
        if [ -d "${d}" ]; then
            local app
            app=$(basename "${d}")
            local cur
            cur=$(basename "$(readlink -f "${d}/current" 2>/dev/null || echo "none")")
            local site_caddy="${CADDY_SITES_DIR}/${app}.caddy"
            local dom="N/A"
            local st="Active"
            if [ -f "${site_caddy}" ]; then
                dom=$(awk '/^http:\/\//{gsub(/http:\/\/|:8088|\{|\s+/, "", $1); print $1; exit}' "${site_caddy}" || echo "N/A")
            fi
            printf "%-16s %-24s %-20s %-10s\n" "${app}" "${dom}" "${cur}" "${st}"
        fi
    done
}

cmd_audit() {
    "${SCRIPTS_DIR}/health_check.sh"
}

case "${1:-}" in
    deploy)
        shift
        cmd_deploy "$@"
        ;;
    update)
        shift
        cmd_update "$@"
        ;;
    rollback)
        shift
        cmd_rollback "$@"
        ;;
    status)
        shift
        cmd_status "$@"
        ;;
    logs)
        shift
        cmd_logs "$@"
        ;;
    restart)
        shift
        cmd_restart "$@"
        ;;
    backup)
        shift
        cmd_backup "$@"
        ;;
    restore)
        shift
        cmd_restore "$@"
        ;;
    remove)
        shift
        cmd_remove "$@"
        ;;
    list)
        cmd_list
        ;;
    audit)
        cmd_audit
        ;;
    *)
        echo "Usage: fana-deploy <command> [args...]"
        echo "Commands:"
        echo "  deploy <url> [as <nama>] [domain <host>]"
        echo "  update <app>"
        echo "  rollback <app>"
        echo "  status [app]"
        echo "  logs <app>"
        echo "  restart <app>"
        echo "  backup <app>"
        echo "  restore <app> <backup>"
        echo "  remove <app>"
        echo "  list"
        echo "  audit"
        exit 1
        ;;
esac
